#!/usr/bin/env python3
"""Root helper with a deliberately small command surface."""

from __future__ import annotations

import os
import re
import sqlite3
import subprocess
import sys
from pathlib import Path
from typing import NoReturn

STATE_DIR = Path("/var/lib/it-projektzentrale")
HELPER_STATE_DIR = Path("/var/lib/it-projektzentrale-helper")
PACKAGE_DIR = STATE_DIR / "uploads" / "packages"
MANAGED_PACKAGES = HELPER_STATE_DIR / "managed-packages"
MANAGED_SERVICES = HELPER_STATE_DIR / "managed-services"
DB_PATH = STATE_DIR / "data" / "projektzentrale.db"
WORKER_PATH = Path("/usr/lib/it-projektzentrale/itpz-helper-worker")
NAME_RE = re.compile(r"[a-z0-9][a-z0-9+.-]+")
SERVICE_RE = re.compile(r"[A-Za-z0-9_.@:-]+\.service")
CONTAINER_RE = re.compile(r"[A-Za-z0-9][A-Za-z0-9_.-]{0,127}")


def fail(message: str) -> NoReturn:
    print(f"itpz-helper: {message}", file=sys.stderr)
    raise SystemExit(2)


def run(command: list[str], timeout: int = 1800) -> subprocess.CompletedProcess[str]:
    return subprocess.run(command, text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=timeout)


def read_set(path: Path) -> set[str]:
    if not path.exists():
        return set()
    return {line.strip() for line in path.read_text(encoding="utf-8").splitlines() if line.strip()}


def write_set(path: Path, values: set[str]) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_suffix(".tmp")
    temporary.write_text("".join(f"{value}\n" for value in sorted(values)), encoding="utf-8")
    os.chmod(temporary, 0o600)
    temporary.replace(path)


def deb_field(path: Path, field: str) -> str:
    result = run(["/usr/bin/dpkg-deb", "--field", str(path), field], timeout=30)
    if result.returncode != 0:
        fail("ungültiges Debian-Paket")
    return result.stdout.strip()


def package_services(path: Path) -> set[str]:
    result = run(["/usr/bin/dpkg-deb", "--contents", str(path)], timeout=30)
    if result.returncode != 0:
        fail("Paketinhalt konnte nicht gelesen werden")
    services = set()
    for line in result.stdout.splitlines():
        candidate = Path(line.split()[-1]).name if line.split() else ""
        if SERVICE_RE.fullmatch(candidate):
            services.add(candidate)
    return services


def install_package(raw_path: str) -> None:
    path = Path(raw_path)
    try:
        resolved = path.resolve(strict=True)
        resolved.relative_to(PACKAGE_DIR.resolve(strict=True))
    except (OSError, ValueError):
        fail("Paket liegt nicht im erlaubten Uploadverzeichnis")
    if not resolved.is_file() or resolved.suffix != ".deb":
        fail("ungültiger Paketpfad")
    package = deb_field(resolved, "Package")
    architecture = deb_field(resolved, "Architecture")
    if not NAME_RE.fullmatch(package):
        fail("ungültiger Paketname")
    host_arch = run(["/usr/bin/dpkg", "--print-architecture"], timeout=10).stdout.strip()
    if architecture not in {"all", host_arch}:
        fail(f"Paketarchitektur {architecture} passt nicht zu {host_arch}")
    simulation = run(["/usr/bin/apt-get", "--simulate", "install", "-y", str(resolved)])
    if simulation.returncode != 0:
        print(simulation.stderr, file=sys.stderr)
        raise SystemExit(simulation.returncode)
    services = package_services(resolved)
    result = run(["/usr/bin/apt-get", "install", "-y", str(resolved)])
    sys.stdout.write(result.stdout)
    sys.stderr.write(result.stderr)
    if result.returncode != 0:
        raise SystemExit(result.returncode)
    packages = read_set(MANAGED_PACKAGES)
    packages.add(package)
    write_set(MANAGED_PACKAGES, packages)
    allowed_services = read_set(MANAGED_SERVICES)
    allowed_services.update(services)
    write_set(MANAGED_SERVICES, allowed_services)


def remove_package(package: str) -> None:
    if not NAME_RE.fullmatch(package) or package not in read_set(MANAGED_PACKAGES):
        fail("Paket ist nicht als verwaltetes Projekt registriert")
    result = run(["/usr/bin/apt-get", "remove", "-y", "--", package])
    sys.stdout.write(result.stdout)
    sys.stderr.write(result.stderr)
    if result.returncode != 0:
        raise SystemExit(result.returncode)
    packages = read_set(MANAGED_PACKAGES)
    packages.discard(package)
    write_set(MANAGED_PACKAGES, packages)
    rebuild_allowlists()


def service_action(action: str, service: str) -> None:
    if action not in {"start", "stop", "restart", "enable", "disable"}:
        fail("unzulässige Dienstaktion")
    if not SERVICE_RE.fullmatch(service) or service not in read_set(MANAGED_SERVICES):
        fail("Dienst ist nicht als verwalteter Paketdienst registriert")
    result = run(["/usr/bin/systemctl", action, "--", service], timeout=120)
    sys.stdout.write(result.stdout)
    sys.stderr.write(result.stderr)
    if result.returncode != 0:
        raise SystemExit(result.returncode)


def docker_action(action: str, container: str) -> None:
    if action not in {"start", "stop", "restart"} or not CONTAINER_RE.fullmatch(container):
        fail("unzulässige Containeraktion")
    if not Path("/usr/bin/docker").exists():
        fail("Docker ist nicht installiert")
    inspected = run(["/usr/bin/docker", "container", "inspect", "--", container], timeout=30)
    if inspected.returncode != 0:
        fail("Container wurde nicht gefunden")
    result = run(["/usr/bin/docker", action, "--", container], timeout=300)
    sys.stdout.write(result.stdout)
    sys.stderr.write(result.stderr)
    if result.returncode != 0:
        raise SystemExit(result.returncode)


def apt_upgrade(mode: str) -> None:
    if mode not in {"safe", "security"}:
        fail("unzulässiger Updatemodus")
    update = run(["/usr/bin/apt-get", "update"], timeout=1200)
    sys.stdout.write(update.stdout)
    sys.stderr.write(update.stderr)
    if update.returncode != 0:
        raise SystemExit(update.returncode)
    command = ["/usr/bin/apt-get", "upgrade", "-y", "--with-new-pkgs"]
    if mode == "security":
        command.extend(["-o", "Dir::Etc::sourcelist=/etc/apt/sources.list.d/debian.sources"])
    result = run(command, timeout=3600)
    sys.stdout.write(result.stdout)
    sys.stderr.write(result.stderr)
    if result.returncode != 0:
        raise SystemExit(result.returncode)


def rebuild_allowlists() -> None:
    packages: set[str] = set()
    services: set[str] = set()
    if DB_PATH.exists():
        with sqlite3.connect(DB_PATH) as connection:
            rows = connection.execute("SELECT package_name,service_name FROM projects WHERE deleted_at IS NULL").fetchall()
        for package, service in rows:
            if not package or not NAME_RE.fullmatch(package):
                continue
            installed = run(["/usr/bin/dpkg-query", "-W", "-f=${Status}", package], timeout=20)
            if installed.returncode != 0 or "install ok installed" not in installed.stdout:
                continue
            packages.add(package)
            if service and not service.endswith(".service"):
                service += ".service"
            if not service or not SERVICE_RE.fullmatch(service):
                continue
            fragment = run(["/usr/bin/systemctl", "show", "-p", "FragmentPath", "--value", service], timeout=20)
            path = fragment.stdout.strip()
            if not path:
                continue
            owner = run(["/usr/bin/dpkg-query", "-S", path], timeout=20)
            if owner.returncode == 0 and owner.stdout.split(":", 1)[0] == package:
                services.add(service)
    services.update({"it-projektzentrale.service", "nginx.service", "docker.service", "ssh.service"})
    write_set(MANAGED_PACKAGES, packages)
    write_set(MANAGED_SERVICES, services)


def worker_main() -> None:
    if os.geteuid() != 0:
        fail("muss als root ausgeführt werden")
    if len(sys.argv) < 2:
        fail("Befehl fehlt")
    command = sys.argv[1]
    if command == "install" and len(sys.argv) == 3:
        install_package(sys.argv[2])
    elif command == "remove" and len(sys.argv) == 3:
        remove_package(sys.argv[2])
    elif command == "service" and len(sys.argv) == 4:
        service_action(sys.argv[2], sys.argv[3])
    elif command == "docker" and len(sys.argv) == 4:
        docker_action(sys.argv[2], sys.argv[3])
    elif command == "apt-upgrade" and len(sys.argv) == 3:
        apt_upgrade(sys.argv[2])
    elif command == "rebuild-allowlists" and len(sys.argv) == 2:
        rebuild_allowlists()
    else:
        fail("unbekannter oder unvollständiger Befehl")


def validate_public_arguments(arguments: list[str]) -> list[str]:
    if not arguments:
        fail("Befehl fehlt")
    command = arguments[0]
    if command == "install" and len(arguments) == 2:
        path = Path(arguments[1])
        try:
            resolved = path.resolve(strict=True)
            resolved.relative_to(PACKAGE_DIR.resolve(strict=True))
        except (OSError, ValueError):
            fail("Paket liegt nicht im erlaubten Uploadverzeichnis")
        if not resolved.is_file() or resolved.suffix != ".deb":
            fail("ungültiger Paketpfad")
        return [command, str(resolved)]
    if command == "remove" and len(arguments) == 2 and NAME_RE.fullmatch(arguments[1]):
        return arguments
    if command == "service" and len(arguments) == 3 and arguments[1] in {"start", "stop", "restart", "enable", "disable"} and SERVICE_RE.fullmatch(arguments[2]):
        return arguments
    if command == "docker" and len(arguments) == 3 and arguments[1] in {"start", "stop", "restart"} and CONTAINER_RE.fullmatch(arguments[2]):
        return arguments
    if command == "apt-upgrade" and len(arguments) == 2 and arguments[1] in {"safe", "security"}:
        return arguments
    if command == "rebuild-allowlists" and len(arguments) == 1:
        return arguments
    fail("unbekannter oder unvollständiger Befehl")


def public_main() -> None:
    if os.geteuid() != 0:
        fail("muss als root ausgeführt werden")
    arguments = validate_public_arguments(sys.argv[1:])
    unit = f"itpz-helper-{os.getpid()}"
    result = run(["/usr/bin/systemd-run", "--quiet", "--wait", "--pipe", "--collect", "--service-type=exec", f"--unit={unit}", str(WORKER_PATH), *arguments])
    sys.stdout.write(result.stdout)
    sys.stderr.write(result.stderr)
    raise SystemExit(result.returncode)


def main() -> None:
    if Path(sys.argv[0]).name == "itpz-helper-worker":
        worker_main()
    else:
        public_main()


if __name__ == "__main__":
    main()
