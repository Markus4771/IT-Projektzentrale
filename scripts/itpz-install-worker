#!/usr/bin/env python3
"""Serialisierter Installations-Worker für IT-Projektzentrale 2.1.0."""

from __future__ import annotations

import os
import shutil
import socket
import sqlite3
import subprocess
import time
import urllib.request
from datetime import datetime, timezone
from pathlib import Path

STATE = Path(os.environ.get("ITPZ_STATE_DIR", "/var/lib/it-projektzentrale"))
DB = STATE / "data" / "projektzentrale.db"
PACKAGES = STATE / "uploads" / "packages"
BACKUPS = STATE / "backups" / "installations"
HELPER = os.environ.get("ITPZ_SYSTEM_HELPER", "/usr/lib/it-projektzentrale/itpz-helper")
WORKER_ID = f"{socket.gethostname()}:{os.getpid()}"
POLL_SECONDS = max(2, int(os.environ.get("ITPZ_WORKER_POLL_SECONDS", "5")))
MAX_LOG = 100_000


def now() -> str:
    return datetime.now(timezone.utc).isoformat()


def connect() -> sqlite3.Connection:
    connection = sqlite3.connect(DB, timeout=30)
    connection.row_factory = sqlite3.Row
    connection.execute("PRAGMA foreign_keys=ON")
    connection.execute("PRAGMA busy_timeout=30000")
    return connection


def append_log(job_id: int, text: str, error: bool = False) -> None:
    if not text:
        return
    field = "error" if error else "output"
    with connect() as conn:
        current = conn.execute(f"SELECT {field} FROM installation_jobs WHERE id=?", (job_id,)).fetchone()
        value = ((current[0] if current else "") + text)[-MAX_LOG:]
        conn.execute(f"UPDATE installation_jobs SET {field}=?,heartbeat_at=? WHERE id=?", (value, now(), job_id))


def progress(job_id: int, phase: str, percent: int) -> None:
    with connect() as conn:
        conn.execute(
            "UPDATE installation_jobs SET phase=?,progress=?,heartbeat_at=? WHERE id=?",
            (phase, max(0, min(100, percent)), now(), job_id),
        )


def claim() -> dict | None:
    with connect() as conn:
        conn.execute("BEGIN IMMEDIATE")
        row = conn.execute(
            """SELECT j.*,p.name project_name,p.package_name,p.service_name,p.health_url,
                      p.latest_file,p.latest_version
               FROM installation_jobs j JOIN projects p ON p.id=j.project_id
               WHERE j.state='queued' ORDER BY j.id LIMIT 1"""
        ).fetchone()
        if not row:
            conn.rollback()
            return None
        changed = conn.execute(
            """UPDATE installation_jobs SET state='running',phase='claimed',progress=1,
                      worker_id=?,started_at=CURRENT_TIMESTAMP,heartbeat_at=?
               WHERE id=? AND state='queued'""",
            (WORKER_ID, now(), row["id"]),
        )
        if changed.rowcount != 1:
            conn.rollback()
            return None
        conn.commit()
        return dict(row)


def run(args: list[str], timeout: int = 1800) -> subprocess.CompletedProcess[str]:
    return subprocess.run(args, text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                          timeout=timeout, check=False)


def installed_version(package: str) -> str:
    if not package:
        return ""
    result = run(["/usr/bin/dpkg-query", "-W", "-f=${Version}", package], 30)
    return result.stdout.strip() if result.returncode == 0 else ""


def create_backup(job: dict) -> str:
    job_dir = BACKUPS / f"job-{job['id']}"
    job_dir.mkdir(parents=True, exist_ok=False)
    os.chmod(job_dir, 0o750)
    with sqlite3.connect(DB) as source, sqlite3.connect(job_dir / "projektzentrale.db") as target:
        source.backup(target)
    package = job.get("package_name") or ""
    version = installed_version(package)
    if package and version:
        candidates = sorted(Path("/var/cache/apt/archives").glob(f"{package}_{version}*.deb"))
        if candidates:
            shutil.copy2(candidates[-1], job_dir / "previous.deb")
    (job_dir / "metadata.txt").write_text(
        f"job={job['id']}\npackage={package}\nprevious_version={version}\ncreated={now()}\n",
        encoding="utf-8",
    )
    return str(job_dir)


def package_path(job: dict) -> Path:
    name = Path(job.get("package_file") or job.get("latest_file") or "").name
    candidate = (PACKAGES / name).resolve()
    candidate.relative_to(PACKAGES.resolve())
    if not candidate.is_file() or candidate.suffix != ".deb":
        raise RuntimeError("Kein gültiges lokales Debian-Paket vorhanden")
    return candidate


def verify_package(path: Path, expected_package: str) -> str:
    result = run(["/usr/bin/dpkg-deb", "--field", str(path), "Package", "Version", "Architecture"], 30)
    if result.returncode != 0:
        raise RuntimeError("Debian-Paket konnte nicht geprüft werden")
    lines = [line.strip() for line in result.stdout.splitlines() if line.strip()]
    if not lines or lines[0] != expected_package:
        raise RuntimeError("Paketname stimmt nicht mit dem Projekt überein")
    return lines[1] if len(lines) > 1 else ""


def health_check(job: dict) -> None:
    service = (job.get("service_name") or "").strip()
    if service:
        if not service.endswith(".service"):
            service += ".service"
        result = run(["/usr/bin/systemctl", "is-active", "--quiet", service], 30)
        if result.returncode != 0:
            raise RuntimeError(f"Dienst {service} ist nach der Installation nicht aktiv")
    url = (job.get("health_url") or "").strip()
    if url:
        if not url.startswith(("http://127.0.0.1", "http://localhost", "https://127.0.0.1", "https://localhost")):
            raise RuntimeError("Health-URL muss lokal sein")
        request = urllib.request.Request(url, headers={"User-Agent": "ITPZ-Worker/2.1"})
        with urllib.request.urlopen(request, timeout=15) as response:
            if response.status < 200 or response.status >= 400:
                raise RuntimeError(f"Health-Check meldet HTTP {response.status}")


def rollback(job: dict, backup_path: str) -> bool:
    previous = Path(backup_path) / "previous.deb"
    if previous.is_file():
        result = run(["/usr/bin/sudo", HELPER, "install", str(previous)], 1800)
        append_log(job["id"], "\n--- Rollback ---\n" + result.stdout)
        append_log(job["id"], result.stderr, True)
        return result.returncode == 0
    return False


def finish(job_id: int, state: str, phase: str, percent: int, error: str = "", rollback_state: str = "") -> None:
    with connect() as conn:
        conn.execute(
            """UPDATE installation_jobs SET state=?,phase=?,progress=?,error=CASE WHEN ?='' THEN error ELSE ? END,
                      rollback_state=?,finished_at=CURRENT_TIMESTAMP,heartbeat_at=? WHERE id=?""",
            (state, phase, percent, error, error[-MAX_LOG:], rollback_state, now(), job_id),
        )


def process(job: dict) -> None:
    job_id = job["id"]
    backup_path = job.get("backup_path") or ""
    try:
        if job["job_type"] == "refresh":
            raise RuntimeError("Release-Abruf muss zuerst über die Paketquelle ausgeführt werden")
        if job["job_type"] == "rollback":
            progress(job_id, "rollback", 30)
            if not rollback(job, backup_path):
                raise RuntimeError("Vorheriges Debian-Paket ist nicht im Backup vorhanden")
            progress(job_id, "health-check", 85)
            health_check(job)
            finish(job_id, "rolled_back", "completed", 100, rollback_state="succeeded")
            return
        package = job.get("package_name") or ""
        previous = installed_version(package)
        with connect() as conn:
            conn.execute("UPDATE installation_jobs SET previous_version=? WHERE id=?", (previous, job_id))
        if job["job_type"] == "remove":
            progress(job_id, "removing", 50)
            result = run(["/usr/bin/sudo", HELPER, "remove", package], 1800)
            append_log(job_id, result.stdout)
            append_log(job_id, result.stderr, True)
            if result.returncode != 0:
                raise RuntimeError("Deinstallation fehlgeschlagen")
            finish(job_id, "succeeded", "completed", 100)
            return
        progress(job_id, "validating", 10)
        path = package_path(job)
        target = verify_package(path, package)
        with connect() as conn:
            conn.execute("UPDATE installation_jobs SET package_file=?,target_version=? WHERE id=?", (path.name, target, job_id))
        progress(job_id, "backup", 25)
        backup_path = create_backup(job)
        with connect() as conn:
            conn.execute("UPDATE installation_jobs SET backup_path=? WHERE id=?", (backup_path, job_id))
        progress(job_id, "installing", 45)
        result = run(["/usr/bin/sudo", HELPER, "install", str(path)], 1800)
        append_log(job_id, result.stdout)
        append_log(job_id, result.stderr, True)
        if result.returncode != 0:
            raise RuntimeError("Paketinstallation fehlgeschlagen")
        progress(job_id, "health-check", 85)
        health_check(job)
        progress(job_id, "registering", 95)
        with connect() as conn:
            conn.execute(
                "UPDATE projects SET installed_version=?,installation_status='installed',updated_at=CURRENT_TIMESTAMP WHERE id=?",
                (installed_version(package) or target, job["project_id"]),
            )
        finish(job_id, "succeeded", "completed", 100)
    except Exception as exc:
        message = str(exc)
        append_log(job_id, f"\nFehler: {message}\n", True)
        rollback_state = ""
        if backup_path and job.get("job_type") in {"install", "update"}:
            progress(job_id, "rollback", 90)
            rollback_state = "succeeded" if rollback(job, backup_path) else "unavailable"
        finish(job_id, "failed", "failed", 100, message, rollback_state)


def recover_stale_jobs() -> None:
    with connect() as conn:
        conn.execute(
            """UPDATE installation_jobs SET state='failed',phase='failed',progress=100,
                      error=error || '\nWorker wurde während der Ausführung beendet.',finished_at=CURRENT_TIMESTAMP
               WHERE state='running' AND (heartbeat_at IS NULL OR heartbeat_at < datetime('now','-15 minutes'))"""
        )


def main() -> None:
    BACKUPS.mkdir(parents=True, exist_ok=True)
    recover_stale_jobs()
    while True:
        job = claim()
        if job:
            process(job)
        else:
            time.sleep(POLL_SECONDS)


if __name__ == "__main__":
    main()
