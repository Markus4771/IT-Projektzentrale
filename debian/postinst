#!/bin/sh
set -eu

APP_USER=it-projektzentrale
APP_DIR=/opt/it-projektzentrale
STATE_DIR=/var/lib/it-projektzentrale
HELPER_STATE_DIR=/var/lib/it-projektzentrale-helper
VENV_DIR=$STATE_DIR/venv
NGINX_AVAILABLE=/etc/nginx/sites-available/it-projektzentrale.conf
NGINX_ENABLED=/etc/nginx/sites-enabled/it-projektzentrale.conf
SERVICE=it-projektzentrale.service
CONFIG=/etc/it-projektzentrale.conf

if ! getent passwd "$APP_USER" >/dev/null 2>&1; then
    adduser --system --group --home "$STATE_DIR" --no-create-home "$APP_USER"
fi

install -d -m 0750 -o "$APP_USER" -g "$APP_USER" \
    "$STATE_DIR" "$STATE_DIR/data" "$STATE_DIR/uploads" "$STATE_DIR/uploads/packages" \
    "$STATE_DIR/backups" "$STATE_DIR/exports"
install -d -m 0700 -o root -g root "$HELPER_STATE_DIR"

# Bestandsdaten aus Beta 1 übernehmen.
for directory in data uploads backups exports; do
    if [ -d "$APP_DIR/$directory" ]; then
        cp -a "$APP_DIR/$directory/." "$STATE_DIR/$directory/"
    fi
done

chown -R root:root "$APP_DIR"
chmod -R u=rwX,go=rX "$APP_DIR"
chown -R "$APP_USER:$APP_USER" "$STATE_DIR"
chmod 0750 "$STATE_DIR" "$STATE_DIR/data" "$STATE_DIR/uploads" "$STATE_DIR/uploads/packages" "$STATE_DIR/backups" "$STATE_DIR/exports"

if [ ! -x "$VENV_DIR/bin/python" ]; then
    python3 -m venv "$VENV_DIR"
    chown -R "$APP_USER:$APP_USER" "$VENV_DIR"
fi
runuser -u "$APP_USER" -- "$VENV_DIR/bin/pip" install --disable-pip-version-check --upgrade pip
runuser -u "$APP_USER" -- "$VENV_DIR/bin/pip" install --disable-pip-version-check -r "$APP_DIR/requirements.txt"

NEW_PASSWORD=0
NEEDS_CONFIG=0
if [ ! -f "$CONFIG" ]; then
    NEEDS_CONFIG=1
elif ! grep -Eq '^ITPZ_SECRET=.{32,}$' "$CONFIG" || \
     ! grep -Eq '^ITPZ_ADMIN_PASSWORD=.{12,}$' "$CONFIG" || \
     grep -qx 'ITPZ_ADMIN_PASSWORD=admin' "$CONFIG"; then
    NEEDS_CONFIG=1
fi

if [ "$NEEDS_CONFIG" -eq 1 ]; then
    HAS_USERS=$(python3 - "$STATE_DIR/data/projektzentrale.db" <<'PY_USERS'
import sqlite3
import sys

try:
    with sqlite3.connect(sys.argv[1]) as connection:
        exists = connection.execute(
            "SELECT 1 FROM sqlite_master WHERE type='table' AND name='users'"
        ).fetchone()
        count = connection.execute("SELECT COUNT(*) FROM users").fetchone()[0] if exists else 0
except sqlite3.Error:
    count = 0
print(1 if count else 0)
PY_USERS
)
    INITIAL_PASSWORD=$(openssl rand -hex 16)
    umask 077
    cat > "$CONFIG" <<EOF_CONFIG
ITPZ_SECRET=$(openssl rand -hex 32)
ITPZ_ADMIN_USER=admin
ITPZ_ADMIN_PASSWORD=$INITIAL_PASSWORD
ITPZ_STATE_DIR=$STATE_DIR
ITPZ_SYSTEM_HELPER=/usr/lib/it-projektzentrale/itpz-helper
ITPZ_MAX_UPLOAD_BYTES=268435456
EOF_CONFIG
    if [ "$HAS_USERS" -eq 0 ]; then
        printf 'Benutzer: admin\nInitialpasswort: %s\n' "$INITIAL_PASSWORD" > /root/it-projektzentrale-initial-password
        chmod 0600 /root/it-projektzentrale-initial-password
        NEW_PASSWORD=1
    fi
fi
chmod 0600 "$CONFIG"

cat > /etc/sudoers.d/it-projektzentrale <<'EOF_SUDOERS'
it-projektzentrale ALL=(root) NOPASSWD: /usr/lib/it-projektzentrale/itpz-helper *
EOF_SUDOERS
chmod 0440 /etc/sudoers.d/it-projektzentrale
if command -v visudo >/dev/null 2>&1; then
    visudo -cf /etc/sudoers.d/it-projektzentrale >/dev/null
fi

rm -f /etc/nginx/sites-enabled/it-projektzentrale
ln -sfn "$NGINX_AVAILABLE" "$NGINX_ENABLED"
rm -f /etc/nginx/sites-enabled/default

systemctl daemon-reload
/usr/lib/it-projektzentrale/itpz-helper rebuild-allowlists || true

if ! nginx -t; then
    echo "Fehler: Die Nginx-Konfiguration ist ungültig." >&2
    exit 1
fi

systemctl enable "$SERVICE" nginx.service >/dev/null 2>&1 || true
systemctl restart "$SERVICE"
systemctl restart nginx.service

IP_ADDR=$(hostname -I 2>/dev/null | awk '{print $1}')
[ -n "$IP_ADDR" ] || IP_ADDR="SERVER-IP"
echo ""
echo "IT-Projektzentrale 1.0.0 Beta 2 wurde eingerichtet."
echo "Aufruf: http://$IP_ADDR/"
if [ "$NEW_PASSWORD" -eq 1 ]; then
    echo "Initialzugang: /root/it-projektzentrale-initial-password"
    echo "Beim ersten Login muss das Passwort geändert werden."
fi
exit 0
